# ============================================================================
# API — variables de entorno
#
# Copia este archivo a `.env` (o `.env.local`) y completa los valores.
# Nunca subas `.env` / `.env.local` al repositorio: están ignorados por git.
#
# En Vercel estas mismas variables se configuran en
# Project → Settings → Environment Variables.
# ============================================================================

# ----------------------------------------------------------------------------
# Servidor
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# Base de datos (MySQL 8 / Aiven)
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=defaultdb
DB_USER=root
DB_PASSWORD=
# 1 = exigir SSL (Aiven); 0 = sin SSL (MySQL local)
DB_SSL=1
# Pool de conexiones (por instancia)
POOL_MAX=5
POOL_MIN=0
POOL_ACQUIRE=30000
POOL_IDLE=10000

# ----------------------------------------------------------------------------
# Autenticación
# Genera un secreto de 32+ bytes, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ----------------------------------------------------------------------------
JWT_SECRET=

# ----------------------------------------------------------------------------
# Cloudinary (fotos de productos en producción)
# Si falta CLOUDINARY_CLOUD_NAME se guardan en disco local (solo desarrollo).
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# local | cloudinary (opcional; fuerza el almacenamiento)
UPLOAD_STORAGE=

# ----------------------------------------------------------------------------
# Web Push (VAPID) — notificaciones de pedidos nuevos en el panel
#
# Genera el par de claves UNA sola vez y usa el mismo par en el backend:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# - VAPID_PUBLIC_KEY: 65 bytes en base64url (~87 caracteres).
#   Es la que el frontend pide en GET /api/push/clave.
# - VAPID_PRIVATE_KEY: 32 bytes en base64url (~43 caracteres).
#   No debe salir del servidor.
# - VAPID_SUBJECT: contacto del administrador del servicio. Debe ser un
#   `mailto:` válido o una URL https. Los servicios de push lo usan para
#   contactarte si tu servidor envía notificaciones abusivas.
#
# Si faltan o son inválidas, la API arranca igual y el push queda desactivado
# (los pedidos siguen funcionando); el motivo aparece en el log `[push]`.
# ----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@tu-dominio.com
